# Supabase Configuration - server-only, used by api/*.js (Vercel serverless functions).
# NEVER prefix these with VITE_ - only VITE_ vars are exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase project id - used server-side to verify Firebase ID tokens
# (via Google's public JWKS endpoint - no service account key needed).
FIREBASE_PROJECT_ID=your-firebase-project-id