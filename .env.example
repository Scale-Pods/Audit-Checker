SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign/verify the 12-hour session JWT issued by /api/login.
# Server-only - never prefix with VITE_.
AUTH_SECRET=generate-a-long-random-hex-string
